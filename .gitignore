# Binaries (anchored to top-level so cmd/stack-explorer/ source dir is not matched)
/stack-explorer
/bin/

# Local-only YAML backups (use scripts/export-state.sh for portable exports)
*-backup.yaml

# Database (generated; export via scripts/export-state.sh)
data/*.db
data/*.db-shm
data/*.db-wal
data/scans/

# Generated reports
reports/*.md
!reports/.gitkeep

# Clone-on-demand target
tmp/

# macOS
.DS_Store

# Git worktrees
.worktrees/

# Local repo catalog (personal clone paths) — start from repos.example.yaml
/repos.yaml

# Local agent docs (not published)
/CLAUDE.md
/docs/superpowers/
/docs/stack-explorer-api-prompt.md
/docs/portfolio-summary-2026-04.md
/docs/proposed-knowledge-base-architecture.md
/docs/install-on-new-machine.md
